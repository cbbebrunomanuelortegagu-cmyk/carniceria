# Plantilla versionable. Copiar a .env para configurar la conexión local.
# Host y puerto comprobados para la instancia MySQL local.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
# Completar con el nombre del esquema y el usuario de MySQL.
DATABASE_NAME=edenfarm
DATABASE_USER=
# La contraseña real va únicamente en .env, nunca aquí.
DATABASE_PASSWORD=
DATABASE_SSL=false
CATALOG_IMAGE_DIR=uploads/catalogo
HERO_IMAGE_DIR=uploads/portada
